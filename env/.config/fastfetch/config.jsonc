{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "modules": [
        "title",
        "separator",
        "os",
        "uptime",
        "terminalfont",
        "packages",
        {
            "type": "command",
            "key": "Updates",
            "text": "$(checkupdates 2>/dev/null | wc -l)"
        },
        "wm",
        "terminal",
        "gpu",
        "localip",
        "disk",
        "display"
    ]
}
